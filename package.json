{
  "name": "maplibre-editor-layer-index-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter maplibre-editor-layer-index build",
    "eli:build": "bun run --filter maplibre-editor-layer-index eli:build",
    "test": "bun run --filter maplibre-editor-layer-index test",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "oxlint -c oxlint.config.mjs .",
    "format": "oxfmt -c oxfmt.config.mjs .",
    "format:check": "oxfmt -c oxfmt.config.mjs --check .",
    "prepare": "husky",
    "check-exports": "bun run --filter maplibre-editor-layer-index check-exports",
    "dev": "bun run --filter preview dev",
    "version-packages": "changeset version",
    "release": "bun run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "husky": "^9.1.7",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "typescript": "^5.7.2"
  },
  "packageManager": "bun@1.3.14"
}
